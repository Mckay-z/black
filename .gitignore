# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template that documents which vars are needed IS committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source photo archive: ~927MB of client originals (incl. HEIC that browsers
# cannot render). Curated, web-sized copies live in public/photos and ARE
# committed. Keep this out of git and out of the deployed bundle.
/public/images

# CMS database. SQLite keeps local development zero-config, but the file holds
# real submissions and password hashes — it never belongs in git.
/cms-data.db
/cms-data.db-shm
/cms-data.db-wal

# Client uploads from the CMS dashboard. Served from /media at runtime and
# backed up with the database, not through source control.
/public/media

# Skills installed by `npx skills add` — machine-local tooling, not project code.
# .claude/skills holds symlinks into .agents, so it is machine-local too.
/.agents
/.claude/skills

# Application attachments (recommendation letters, proof of enrolment).
# Personal data — stored outside public/ and never committed.
/private-uploads
