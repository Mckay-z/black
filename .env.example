# ── Required ──────────────────────────────────────────────────────────────
# Signs the dashboard's auth cookies. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. Never commit the real value.
PAYLOAD_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
# Local development uses a SQLite file and needs no value here.
# For production, see "Going to production" in CMS.md.
# DATABASE_URI=file:./cms-data.db

# ── Optional ──────────────────────────────────────────────────────────────
# The site's public URL, used for CORS and absolute links in emails.
# NEXT_PUBLIC_SITE_URL=https://blackinrehab.org
